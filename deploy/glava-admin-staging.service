[Unit]
Description=GLAVA Admin Panel — Staging (dev branch)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/glava-staging
ExecStart=/opt/glava-staging/venv/bin/gunicorn -w 1 -b 0.0.0.0:5002 admin.app:app
Restart=always
RestartSec=10
EnvironmentFile=/opt/glava/.env

[Install]
WantedBy=multi-user.target
