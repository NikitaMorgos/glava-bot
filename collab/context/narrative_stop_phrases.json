{
  "version": "v3",
  "description": "Generic categorical patterns for narrative anti-triggers (task 043b/043d/043g/043f). Universal — no subject-specific content.",
  "generic_categorical_patterns": [
    {
      "category": "metaphor_bonds",
      "pattern": "\\b(семейн\\w+|кровн\\w+|родств\\w+)\\s+узы\\s+(оказ\\w+\\s+)?крепче\\s+\\w+",
      "example_neg_template": "[семейные|кровные|родственные] узы оказались крепче [X]"
    },
    {
      "category": "lifedefining_speciality",
      "pattern": "(определ\\w+|стал\\w+)\\s+(всю|её|его|всей)?\\s*(дальнейш\\w+|будущ\\w+|всю)?\\s*(жизн\\w+|карьер\\w+|судьб\\w+)",
      "example_neg_template": "[профессия] — специальность, которая определила всю [его/её] [жизнь/карьеру]"
    },
    {
      "category": "could_X_any_Y_but_actually_Z",
      "pattern_pair": [
        "\\b(могло|способно)\\s+\\w+\\s+любо\\w+\\s+(матер|отц|родител)",
        "\\bотн\\w+\\s+(спокойн|ровн)\\w+|приняла? спокойно"
      ],
      "description": "пара противоречивых украшений — генеральное преувеличение + успокаивающее"
    },
    {
      "category": "epilogue_path_X_to_Y",
      "pattern": "\\bпуть\\s+от\\s+\\w+\\s+(до|к)\\s+\\w+"
    },
    {
      "category": "filled_with_X",
      "pattern": "(жизн\\w+|жил\\w+)\\s+был\\w+\\s+наполнен\\w+",
      "example_neg_template": "жизнь была наполнена [абстрактное обобщение]"
    },
    {
      "category": "passed_to_generations",
      "pattern": "передал\\w+\\s+(следующ\\w+\\s+поколен|потомк|следующ\\w+\\s+поколения)",
      "example_neg_template": "передались следующим поколениям"
    },
    {
      "category": "person_of_their_time",
      "pattern": "человек\\w{0,4}\\s+своего\\s+времени"
    },
    {
      "category": "speciality_defined_life",
      "pattern": "(специальност\\w+|профессия|обучение)\\s*.{0,30}(определ\\w+|стал\\w+).{0,20}(всю|её|его|их)?\\s*(дальнейш\\w+|жизн\\w+|карьер\\w+|судьб\\w+)",
      "scope": ["epilogue", "ch_02"],
      "severity": "warning",
      "rationale": "v62a-043d Class 1: акушерство ≠ «определило всю жизнь»; образование ≠ профессия"
    },
    {
      "category": "helping_at_important_moments",
      "pattern": "(помога\\w+|оказыва\\w+\\s+помощ\\w+)\\s+\\w+\\s+в\\s+(самы\\w+\\s+)?важн\\w+\\s+момент\\w+\\s+\\w+\\s+жизн\\w+",
      "scope": ["ch_02", "ch_03"],
      "severity": "error",
      "rationale": "v62a-043d Class 1: в TR нет данных о работе акушеркой; pattern = confabulation"
    },
    {
      "category": "event_that_changed_life",
      "pattern": "(событи\\w+|момент\\w+|встреч\\w+|случа\\w+)\\s*.{0,25}(изменил\\w+|переверну\\w+|повернул\\w+)\\s*.{0,20}(жизн\\w+|судьб\\w+|всё)",
      "scope": ["ch_02", "ch_03", "ch_04", "epilogue"],
      "severity": "error",
      "rationale": "v63-043g Class 1: «поворотный момент» / «изменил жизнь» без source_quote = confabulation",
      "fix": "cite source_quote or delete sentence"
    },
    {
      "category": "typical_for_generation",
      "pattern": "(типичн\\w+|обычн\\w+|характерн\\w+)\\s+(для\\s+)?(своег\\w+\\s+)?(поколен\\w+|времен\\w+|эпох\\w+)",
      "scope": ["ch_02", "ch_03", "ch_04", "epilogue"],
      "severity": "warning",
      "rationale": "v63-043g Class 1: «типичный для своего поколения» — обобщение без опоры на TR",
      "fix": "replace with concrete episode from TR or delete"
    },
    {
      "category": "in_this_typicality_uniqueness",
      "pattern": "в\\s+(этой\\s+)?(типичност\\w+|обычност\\w+|простот\\w+)\\s+(и\\s+)?(был\\w+|крыл\\w+|заключал\\w+)\\s+(уникальност\\w+|особенност\\w+|индивидуальност\\w+)",
      "scope": ["epilogue"],
      "severity": "error",
      "rationale": "v63-043g Class 11: парная конструкция «в типичности — уникальность» — литературный штамп без основания"
    },
    {
      "category": "class11_not_loved_x_by_y_and_z",
      "pattern": "не\\s+люб\\w+\\s+(советов?|замечаний?|критик\\w+|указаний?)\\s+(по|от)\\s+\\w+",
      "scope": ["ch_04"],
      "severity": "error",
      "rationale": "v63-043f Class 11 (ЗАПРЕТ 9 GW): «не любил советов по X, Y и Z» = listing antipattern; write generalisation FIRST then example",
      "fix": "rewrite: generalisation first, single example after"
    }
  ],
  "scoped_to_epilogue_only": ["epilogue_path_X_to_Y", "filled_with_X", "passed_to_generations", "person_of_their_time", "in_this_typicality_uniqueness"],
  "scoped_to_narrative_and_epilogue": ["metaphor_bonds", "lifedefining_speciality", "could_X_any_Y_but_actually_Z", "speciality_defined_life", "helping_at_important_moments", "event_that_changed_life", "typical_for_generation", "class11_not_loved_x_by_y_and_z"],
  "scoped_to_chapters": {
    "speciality_defined_life": ["epilogue", "ch_02"],
    "helping_at_important_moments": ["ch_02", "ch_03"],
    "event_that_changed_life": ["ch_02", "ch_03", "ch_04", "epilogue"],
    "typical_for_generation": ["ch_02", "ch_03", "ch_04", "epilogue"],
    "in_this_typicality_uniqueness": ["epilogue"],
    "class11_not_loved_x_by_y_and_z": ["ch_04"]
  }
}
